#[maybe the order should be as to obj]
(add (obj to as)
     (reg reg None (add #to, #obj))
     (reg mem None (add #to, #obj))
     (mem reg None (add #to, #obj))
     (imm mem None (add #to, #obj))
     (imm reg None (add #to, #obj))
)

#[test comment]
(substract (obj from as)
     (reg reg|mem None (sub #from, #obj))
     (imm reg|mem None (sub #from, #obj))
)

(multiply (obj by as)
     (None reg|mem None (mul #by))
     (None reg|mem keyword:signed (imul #by))
     (reg reg|mem keyword:signed (imul #obj, #by))
)

(divide (obj by as)
     (None reg|mem None (div #by))
     (None reg|mem keyword:signed (idiv #by))
)

(move (obj to as with)
     (reg reg|mem None None (mov #to, #obj))
     (reg|mem|label reg None None (mov #to, #obj))
     (imm reg None None (mov #to, #obj))
     (imm reg|mem None None (mov #to, #obj))
     (reg_8|mem_8 reg_16 None keyword:sign-extention (movsx #to, #obj))
     (reg_8|mem_8 reg_32 None keyword:sign-extention (movsx #to, #obj))
     (reg_8|mem_8 reg_64 None keyword:sign-extention (movsx #to, #obj))
     (reg_16|mem_16 reg_32 None keyword:sign-extention (movsx #to, #obj))
     (reg_16|mem_16 reg_64 None keyword:sign-extention (movsx #to, #obj))
     (reg_16|mem_16 reg_16 None keyword:sign-extention (movsxd #to, #obj))
     (reg_32|mem_32 reg_32 None keyword:sign-extention (movsxd #to, #obj))
     (reg_32|mem_32 reg_64 None keyword:sign-extention (movsxd #to, #obj))
     (reg_8|mem_8 reg_16 None keyword:zero-extention (movzx #to, #obj))
     (reg_8|mem_8 reg_32 None keyword:zero-extention (movzx #to, #obj))
     (reg_8|mem_8 reg_64 None keyword:zero-extention (movzx #to, #obj))
     (reg_16|mem_16 reg_32 None keyword:zero-extention (movzx #to, #obj))
     (reg_16|mem_16 reg_64 None keyword:zero-extention (movzx #to, #obj))
)

(jump (obj to if)
     (None label None (jmp #to))
     (None label keyword:== (je #to))
     (None label keyword:!= (jne #to))
     (None label keyword:> (jg #to))
     (None label keyword:>= (jge #to))
     (None label keyword:< (jl #to))
     (None label keyword:<= (jle #to))
)

(and (obj with)
     (reg|mem reg (and #obj, #with))
     (reg reg|mem (and #obj, #with))
)

(or (obj with)
     (reg|mem reg (or #obj, #with))
     (reg reg|mem (or #obj, #with))
)

(xor (obj with)
     (reg|mem reg (xor #obj, #with))
     (reg reg|mem (xor #obj, #with))
)

(not (obj)
     (reg|mem  (not #obj))
)

(negate (obj)
     (reg|mem  (neg #obj))
)

(shift-right (obj by)
     (reg|mem imm (shr #obj, #by))
     (reg|mem reg:cl (shr #obj, #by))
)

(shift-left (obj by)
     (reg|mem imm (shl #obj, #by))
     (reg|mem reg:cl (shl #obj, #by))
)

(call (obj)
     (label (call #obj))
)

(compare (obj with)
     (reg|mem reg (cmp #with, #obj))
     (reg reg|mem (cmp #with, #obj))
     (imm reg|mem (cmp #with, #obj))
)

(return (obj)
     (None (ret))
)

(leave (obj)
     (None (leave))
)

(no-operation (obj)
     (None (nop))
)

(systemcall (obj)
     (None (syscall))
)

(halt (obj)
     (None (hlt))
)

(load-effective-address (obj to)
     (mem reg (lea #to, #obj))
)

(pop (obj)
     (reg_16 (pop #obj))
     (reg_64 (pop #obj))
     (reg_16|mem_16 (pop #obj))
     (reg_64|mem_64 (pop #obj))
)

(push (obj)
     (reg_16 (push #obj))
     (reg_64 (push #obj))
     (reg_16|mem_16 (push #obj))
     (reg_64|mem_64 (push #obj))
)

(set-byte (obj to if)
     (None reg_8|mem_8 None (set #to))
     (None reg_8|mem_8 keyword:== (sete #to))
     (None reg_8|mem_8 keyword:!= (setne #to))
     (None reg_8|mem_8 keyword:> (setg #to))
     (None reg_8|mem_8 keyword:>= (setge #to))
     (None reg_8|mem_8 keyword:< (setl #to))
     (None reg_8|mem_8 keyword:<= (setle #to))
)

(extend-*ax-reg (obj by)
     (None keyword:16bit (cwd))
     (None keyword:32bit (cdq))
     (None keyword:64bit (cqo))
)
